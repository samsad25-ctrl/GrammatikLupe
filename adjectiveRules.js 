const ADJECTIVE_RULES = Object.freeze({

  /*
   ============================================================
   1. BESTIMMTER ARTIKEL
   der / die / das
   ============================================================
  */

  definite: {

    Nominativ: {
      masculine: "e",
      feminine: "e",
      neuter: "e",
      plural: "en"
    },

    Akkusativ: {
      masculine: "en",
      feminine: "e",
      neuter: "e",
      plural: "en"
    },

    Dativ: {
      masculine: "en",
      feminine: "en",
      neuter: "en",
      plural: "en"
    },

    Genitiv: {
      masculine: "en",
      feminine: "en",
      neuter: "en",
      plural: "en"
    }

  },



  /*
   ============================================================
   2. UNBESTIMMT / KEIN / POSSESSIV
   ein / kein / mein / dein ...
   ============================================================
  */

  indefinite: {

    Nominativ: {
      masculine: "er",
      feminine: "e",
      neuter: "es",
      plural: "en"
    },

    Akkusativ: {
      masculine: "en",
      feminine: "e",
      neuter: "es",
