/*
============================================================
ENDUNG ERMITTELN
============================================================
*/


function getAdjectiveEnding({

  articleType,

  grammaticalCase,

  gender,

  number

}) {


  const ruleGroup =
    ADJECTIVE_RULES[
      articleType
    ];



  if(!ruleGroup){

    return null;

  }



  const caseRule =
    ruleGroup[
      grammaticalCase
    ];



  if(!caseRule){

    return null;

  }



  if(
    number === "plural"
  ){

    return caseRule.plural;

  }



  return (
    caseRule[gender]
    ||
    null
  );

}





/*
============================================================
STAMMFORM
============================================================
*/


function getAdjectiveStem(
  adjective
){

  return adjective.replace(

    /(e|en|er|es|em)$/u,

    ""

  );

}





/*
============================================================
FORM PRÜFEN
============================================================
*/


function analyzeAdjectiveForm({

  adjective,

  articleType,

  grammaticalCase,

  gender,

  number

}) {


  const expectedEnding =
    getAdjectiveEnding({

      articleType,

      grammaticalCase,

      gender,

      number

    });



  if(!expectedEnding){

    return null;

  }



  const stem =
    getAdjectiveStem(
      adjective
    );



  const expectedForm =
    stem +
    expectedEnding;



  return {

    observed:
      adjective,


    expected:
      expectedForm,


    expectedEnding,


    correct:

      adjective === expectedForm

  };

}